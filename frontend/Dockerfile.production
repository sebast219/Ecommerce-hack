# Multi-stage Dockerfile para Producción - Frontend Optimizado
# Etapa 1: Build
FROM node:18-alpine AS builder

WORKDIR /app

# Copiar package files
COPY package*.json ./
COPY next.config.js ./

# Instalar dependencias
RUN npm ci --only=production && npm cache clean --force

# Copiar código fuente
COPY . .

# Build estático optimizado
RUN npm run build

# Etapa 2: Runtime - Servidor NGINX
FROM nginx:alpine AS runtime

# Instalar herramientas para health check
RUN apk add --no-cache curl

# Copiar build de Next.js
COPY --from=builder /app/out /usr/share/nginx/html

# Copiar configuración NGINX optimizada
COPY nginx.conf /etc/nginx/nginx.conf

# Crear directorios para cache y logs
RUN mkdir -p /var/cache/nginx /var/log/nginx /tmp && \
    chown -R nginx:nginx /var/cache/nginx /var/log/nginx /tmp

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:80/health || exit 1

# Exponer puerto
EXPOSE 80

# Iniciar NGINX
CMD ["nginx", "-g", "daemon off;"]
