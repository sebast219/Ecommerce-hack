# Multi-stage Dockerfile para Producción - Backend Optimizado
# Etapa 1: Build
FROM node:18-alpine AS builder

WORKDIR /app

# Instalar dependencias de build
COPY package*.json ./
COPY tsconfig.json ./

# Instalar solo dependencias primero para cache layer
RUN npm ci --only=production && npm cache clean --force

# Copiar código fuente
COPY src/ ./src/
COPY prisma/ ./prisma/

# Build de la aplicación
RUN npm run build

# Etapa 2: Runtime - Imagen minimalista
FROM node:18-alpine AS runtime

# Crear usuario no-root para seguridad
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001

WORKDIR /app

# Instalar dumb-init para señales proper
RUN apk add --no-cache dumb-init

# Copiar node_modules de builder (solo production)
COPY --from=builder --chown=nextjs:nodejs /app/node_modules ./node_modules

# Copiar build artifacts
COPY --from=builder --chown=nextjs:nodejs /app/dist ./dist
COPY --from=builder --chown=nextjs:nodejs /app/prisma ./prisma
COPY --from=builder --chown=nextjs:nodejs /app/package.json ./package.json

# Generar Prisma Client
RUN npx prisma generate

# Crear directorios necesarios con permisos correctos
RUN mkdir -p /app/uploads && \
    chown -R nextjs:nodejs /app/uploads

# Cambiar a usuario no-root
USER nextjs

# Exponer puerto
EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node dist/healthcheck.js || exit 1

# Variables de entorno por defecto
ENV NODE_ENV=production
ENV PORT=3001

# Iniciar aplicación con dumb-init
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/main.js"]
